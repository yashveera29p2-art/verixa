rules_version = '2';

// Verixa Firestore rules.
// Each user can read and write ONLY their own profile at users/{uid}.
// Everything else is denied until a later phase adds rules for it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Checks the onboarding fields that every profile must have.
    function validProfile(uid) {
      let d = request.resource.data;
      return d.uid == uid
        && d.phone == request.auth.token.phone_number
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 100
        && d.status in ['student', 'fresher', 'working_professional']
        && d.organisation is string && d.organisation.size() >= 1 && d.organisation.size() <= 150
        && validSections(d);
    }

    // Profile sections (Phase 5): only known fields, each the right type,
    // with sensible size caps so a document can't be stuffed with junk.
    function validSections(d) {
      return d.keys().hasOnly([
          'uid', 'phone', 'fullName', 'status', 'organisation',
          'createdAt', 'updatedAt',
          'contact', 'statusDetails', 'education', 'careerGoal',
          'experience', 'projects', 'skills', 'extras'])
        && (!('contact' in d) || d.contact is map)
        && (!('statusDetails' in d) || d.statusDetails is map)
        && (!('education' in d) || (d.education is map
              && (!('additional' in d.education) || d.education.additional.size() <= 5)))
        && (!('careerGoal' in d) || (d.careerGoal is map
              && (!('objective' in d.careerGoal) || d.careerGoal.objective.size() <= 300)))
        && (!('experience' in d) || (d.experience is map
              && (!('entries' in d.experience) || d.experience.entries.size() <= 20)))
        && (!('projects' in d) || (d.projects is list && d.projects.size() <= 20))
        && (!('skills' in d) || d.skills is map)
        && (!('extras' in d) || d.extras is map);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt;

      // Account deletion will go through a trusted backend later.
      allow delete: if false;

      // Scan history (Phase 7): reports only, never resume files or text.
      // Owners can read, add and delete their own reports; reports are
      // never edited after they're created.
      match /scans/{scanId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validScan(request.resource.data);
        allow update: if false;
      }
    }

    function validScan(d) {
      return d.keys().hasOnly(['fileName', 'createdAt', 'atsScore', 'riskLevel',
                               'threatCount', 'threats', 'breakdown', 'suggestions'])
        && d.fileName is string && d.fileName.size() <= 200
        && d.createdAt == request.time
        && d.atsScore is int && d.atsScore >= 0 && d.atsScore <= 100
        && d.riskLevel in ['clean', 'low', 'medium', 'high']
        && d.threatCount is int && d.threatCount >= 0
        && d.threats is list && d.threats.size() <= 50
        && d.breakdown is list && d.breakdown.size() <= 10
        && d.suggestions is list && d.suggestions.size() <= 20;
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
