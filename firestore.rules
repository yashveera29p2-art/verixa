rules_version = '2';

// Verixa Firestore rules.
// Each user can read and write ONLY their own profile at users/{uid}.
// Everything else is denied until a later phase adds rules for it.
service cloud.firestore {
  match /databases/{database}/documents {

    // Anonymous install counter (one document per phone, written by the
    // app before login). Nobody can read it from the app; view it in the
    // Firebase console. Only these fields, with short values.
    match /installs/{deviceId} {
      allow read, delete: if false;
      allow create: if deviceId.size() <= 64 && validInstall(request.resource.data)
        && request.resource.data.firstOpened == request.time;
      allow update: if validInstall(request.resource.data)
        && request.resource.data.firstOpened == resource.data.firstOpened;
    }

    function validInstall(d) {
      return d.keys().hasOnly(['manufacturer', 'model', 'android', 'appVersion',
                               'firstOpened', 'lastOpened'])
        && d.manufacturer is string && d.manufacturer.size() <= 40
        && d.model is string && d.model.size() <= 60
        && d.android is string && d.android.size() <= 12
        && d.appVersion is string && d.appVersion.size() <= 20
        && d.lastOpened == request.time;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Verixa team members (must match lib/core/utils/admin.dart).
    function isAdmin() {
      return signedIn() && request.auth.token.phone_number in ['+919999999999'];
    }

    // A recruiter whose account the Verixa team has approved.
    function approvedRecruiter() {
      return signedIn()
        && exists(/databases/$(database)/documents/recruiters/$(request.auth.uid))
        && get(/databases/$(database)/documents/recruiters/$(request.auth.uid)).data.status == 'approved';
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    // Checks the onboarding fields that every profile must have.
    function validProfile(uid) {
      let d = request.resource.data;
      return d.uid == uid
        && d.phone == request.auth.token.phone_number
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 100
        && d.status in ['student', 'fresher', 'working_professional']
        && d.organisation is string && d.organisation.size() >= 1 && d.organisation.size() <= 150
        && validSections(d);
    }

    // Profile sections (Phase 5): only known fields, each the right type,
    // with sensible size caps so a document can't be stuffed with junk.
    function validSections(d) {
      return d.keys().hasOnly([
          'uid', 'phone', 'fullName', 'status', 'organisation',
          'createdAt', 'updatedAt',
          'contact', 'statusDetails', 'education', 'careerGoal',
          'experience', 'projects', 'skills', 'extras',
          'role', 'workStyle', 'visibleToRecruiters'])
        && (!('role' in d) || d.role in ['student', 'recruiter'])
        && (!('workStyle' in d) || d.workStyle is map)
        && (!('visibleToRecruiters' in d) || d.visibleToRecruiters is bool)
        && (!('contact' in d) || d.contact is map)
        && (!('statusDetails' in d) || d.statusDetails is map)
        && (!('education' in d) || (d.education is map
              && (!('additional' in d.education) || d.education.additional.size() <= 5)))
        && (!('careerGoal' in d) || (d.careerGoal is map
              && (!('objective' in d.careerGoal) || d.careerGoal.objective.size() <= 300)))
        && (!('experience' in d) || (d.experience is map
              && (!('entries' in d.experience) || d.experience.entries.size() <= 20)))
        && (!('projects' in d) || (d.projects is list && d.projects.size() <= 20))
        && (!('skills' in d) || d.skills is map)
        && (!('extras' in d) || d.extras is map);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt;

      // Account deletion will go through a trusted backend later.
      allow delete: if false;

      // Scan history (Phase 7): reports only, never resume files or text.
      // Owners can read, add and delete their own reports; reports are
      // never edited after they're created.
      match /scans/{scanId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validScan(request.resource.data);
        allow update: if false;
      }

      // JD match history (Phase 8): report plus a short JD snippet.
      match /matches/{matchId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validMatch(request.resource.data);
        allow update: if false;
      }

      // What this user has seen on each installation (Terms, guided tour).
      match /installs/{installKey} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['termsVersion', 'termsAcceptedAt', 'tour_student', 'tour_recruiter']);
        allow delete: if false;
      }

      // Resume versions (Phase 9): only the user's choices (order, template,
      // summary, cover letter). Content is rebuilt from the profile.
      match /resumes/{resumeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validResume(request.resource.data);
      }
    }

    function validResume(d) {
      return d.keys().hasOnly(['name', 'targetKind', 'targetLabel', 'companyId',
                               'jobTitle', 'template', 'sectionOrder', 'hiddenSections',
                               'summary', 'focusSkills', 'alignmentScore',
                               'coverLetter', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.targetKind in ['general', 'company', 'job']
        && d.targetLabel is string && d.targetLabel.size() <= 160
        && d.companyId is string && d.companyId.size() <= 80
        && d.jobTitle is string && d.jobTitle.size() <= 160
        && d.template in ['classic', 'modern', 'compact']
        && d.sectionOrder is list && d.sectionOrder.size() <= 12
        && d.hiddenSections is list && d.hiddenSections.size() <= 12
        && d.summary is string && d.summary.size() <= 1000
        && d.focusSkills is list && d.focusSkills.size() <= 60
        && (d.alignmentScore == null
            || (d.alignmentScore is int && d.alignmentScore >= 0 && d.alignmentScore <= 100))
        && d.coverLetter is string && d.coverLetter.size() <= 8000
        && d.updatedAt == request.time;
    }

    function validMatch(d) {
      return d.keys().hasOnly(['jdSnippet', 'createdAt', 'matchScore', 'verdict',
                               'jobTitle', 'seniority', 'yearsRequired', 'education',
                               'skillCoverage', 'requirements', 'matchedSkills',
                               'missingSkills', 'suggestions'])
        && d.jdSnippet is string && d.jdSnippet.size() <= 300
        && d.createdAt == request.time
        && d.matchScore is int && d.matchScore >= 0 && d.matchScore <= 100
        && d.verdict in ['strong', 'good', 'partial', 'low']
        && d.jobTitle is string && d.jobTitle.size() <= 120
        && d.requirements is list && d.requirements.size() <= 40
        && d.matchedSkills is list && d.matchedSkills.size() <= 40
        && d.missingSkills is list && d.missingSkills.size() <= 40
        && d.suggestions is list && d.suggestions.size() <= 10;
    }

    function validScan(d) {
      return d.keys().hasOnly(['fileName', 'createdAt', 'atsScore', 'riskLevel',
                               'threatCount', 'threats', 'breakdown', 'suggestions'])
        && d.fileName is string && d.fileName.size() <= 200
        && d.createdAt == request.time
        && d.atsScore is int && d.atsScore >= 0 && d.atsScore <= 100
        && d.riskLevel in ['clean', 'low', 'medium', 'high']
        && d.threatCount is int && d.threatCount >= 0
        && d.threats is list && d.threats.size() <= 50
        && d.breakdown is list && d.breakdown.size() <= 10
        && d.suggestions is list && d.suggestions.size() <= 20;
    }

    // ── Recruiters ─────────────────────────────────────────────────────
    // A recruiter asks for access (status "pending"); only the Verixa team
    // can change the status.
    match /recruiters/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['fullName', 'company', 'designation', 'workEmail', 'phone', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.phone == request.auth.token.phone_number
        && shortString(request.resource.data.fullName, 100)
        && shortString(request.resource.data.company, 120)
        && shortString(request.resource.data.designation, 100)
        && shortString(request.resource.data.workEmail, 150)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if false;

      // Shortlisted candidates (name and headline only).
      match /shortlist/{candidateUid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && approvedRecruiter()
          && request.resource.data.keys().hasOnly(['fullName', 'headline', 'jobTitle', 'addedAt']);
      }
    }

    // Jobs posted by approved recruiters; students see them in Jobs.
    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if approvedRecruiter() && validJob(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']);
      allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();

      // "I'm interested" from a student; the job's recruiter can see who.
      match /interested/{studentUid} {
        allow read: if isOwner(studentUid)
          || (signedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.ownerUid == request.auth.uid);
        allow create: if isOwner(studentUid) && request.resource.data.keys().hasOnly(['at']);
        allow delete: if isOwner(studentUid);
      }
    }

    function validJob(d) {
      return d.keys().hasOnly(['ownerUid', 'company', 'title', 'location', 'type',
                               'payMinLpa', 'payMaxLpa', 'description', 'skills',
                               'wantedTraits', 'hidden', 'createdAt'])
        && shortString(d.company, 120) && d.company.size() > 0
        && shortString(d.title, 120) && d.title.size() > 0
        && shortString(d.location, 120)
        && d.type in ['full_time', 'internship', 'part_time']
        && d.payMinLpa is number && d.payMaxLpa is number
        && d.payMinLpa >= 0 && d.payMaxLpa >= 0 && d.payMaxLpa <= 500
        && shortString(d.description, 4000)
        && d.skills is list && d.skills.size() <= 20
        && d.wantedTraits is map;
    }

    // A student's card for recruiters, only while they choose to be visible.
    match /candidates/{uid} {
      allow read: if isOwner(uid) || approvedRecruiter() || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'fullName', 'college', 'degree', 'branch', 'graduationYear', 'city',
             'targetRole', 'skills', 'projectTitles', 'links', 'traits',
             'matchProfile', 'updatedAt'])
        && shortString(request.resource.data.fullName, 100)
        && request.resource.data.skills is list && request.resource.data.skills.size() <= 30
        && request.resource.data.links is list && request.resource.data.links.size() <= 3
        && request.resource.data.traits is map
        && request.resource.data.matchProfile is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // Company reviews: one per person per company (id = companyId_uid),
    // anonymous in the app. The team can hide reviews.
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && validReview(reviewId, request.resource.data)
        && request.resource.data.hidden == false;
      allow update: if (signedIn() && resource.data.uid == request.auth.uid
                        && validReview(reviewId, request.resource.data)
                        && request.resource.data.hidden == resource.data.hidden)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']));
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    function validReview(reviewId, d) {
      return d.keys().hasOnly(['companyId', 'companyName', 'uid', 'author', 'workedThere',
                               'overall', 'workLife', 'pay', 'security', 'text',
                               'hidden', 'createdAt'])
        && d.uid == request.auth.uid
        && reviewId == d.companyId + '_' + request.auth.uid
        && shortString(d.companyId, 80) && shortString(d.companyName, 120)
        && d.author in ['Student', 'Intern', 'Employee']
        && d.workedThere is bool
        && d.overall is int && d.overall >= 1 && d.overall <= 5
        && d.workLife is int && d.workLife >= 1 && d.workLife <= 5
        && d.pay is int && d.pay >= 1 && d.pay <= 5
        && d.security is int && d.security >= 1 && d.security <= 5
        && shortString(d.text, 800)
        && d.createdAt == request.time;
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
