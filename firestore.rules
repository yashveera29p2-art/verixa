rules_version = '2';

// Verixa Firestore rules.
// Each user can read and write ONLY their own profile at users/{uid}.
// Everything else is denied until a later phase adds rules for it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Checks the onboarding fields that every profile must have.
    function validProfile(uid) {
      let d = request.resource.data;
      return d.uid == uid
        && d.phone == request.auth.token.phone_number
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 100
        && d.status in ['student', 'fresher', 'working_professional']
        && d.organisation is string && d.organisation.size() >= 1 && d.organisation.size() <= 150
        && validSections(d);
    }

    // Profile sections (Phase 5): only known fields, each the right type,
    // with sensible size caps so a document can't be stuffed with junk.
    function validSections(d) {
      return d.keys().hasOnly([
          'uid', 'phone', 'fullName', 'status', 'organisation',
          'createdAt', 'updatedAt',
          'contact', 'statusDetails', 'education', 'careerGoal',
          'experience', 'projects', 'skills', 'extras'])
        && (!('contact' in d) || d.contact is map)
        && (!('statusDetails' in d) || d.statusDetails is map)
        && (!('education' in d) || (d.education is map
              && (!('additional' in d.education) || d.education.additional.size() <= 5)))
        && (!('careerGoal' in d) || (d.careerGoal is map
              && (!('objective' in d.careerGoal) || d.careerGoal.objective.size() <= 300)))
        && (!('experience' in d) || (d.experience is map
              && (!('entries' in d.experience) || d.experience.entries.size() <= 20)))
        && (!('projects' in d) || (d.projects is list && d.projects.size() <= 20))
        && (!('skills' in d) || d.skills is map)
        && (!('extras' in d) || d.extras is map);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt;

      // Account deletion will go through a trusted backend later.
      allow delete: if false;

      // Scan history (Phase 7): reports only, never resume files or text.
      // Owners can read, add and delete their own reports; reports are
      // never edited after they're created.
      match /scans/{scanId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validScan(request.resource.data);
        allow update: if false;
      }

      // JD match history (Phase 8): report plus a short JD snippet.
      match /matches/{matchId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validMatch(request.resource.data);
        allow update: if false;
      }

      // Resume versions (Phase 9): only the user's choices (order, template,
      // summary, cover letter). Content is rebuilt from the profile.
      match /resumes/{resumeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validResume(request.resource.data);
      }
    }

    function validResume(d) {
      return d.keys().hasOnly(['name', 'targetKind', 'targetLabel', 'companyId',
                               'jobTitle', 'template', 'sectionOrder', 'hiddenSections',
                               'summary', 'focusSkills', 'alignmentScore',
                               'coverLetter', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.targetKind in ['general', 'company', 'job']
        && d.targetLabel is string && d.targetLabel.size() <= 160
        && d.companyId is string && d.companyId.size() <= 80
        && d.jobTitle is string && d.jobTitle.size() <= 160
        && d.template in ['classic', 'modern', 'compact']
        && d.sectionOrder is list && d.sectionOrder.size() <= 12
        && d.hiddenSections is list && d.hiddenSections.size() <= 12
        && d.summary is string && d.summary.size() <= 1000
        && d.focusSkills is list && d.focusSkills.size() <= 60
        && (d.alignmentScore == null
            || (d.alignmentScore is int && d.alignmentScore >= 0 && d.alignmentScore <= 100))
        && d.coverLetter is string && d.coverLetter.size() <= 8000
        && d.updatedAt == request.time;
    }

    function validMatch(d) {
      return d.keys().hasOnly(['jdSnippet', 'createdAt', 'matchScore', 'verdict',
                               'jobTitle', 'seniority', 'yearsRequired', 'education',
                               'skillCoverage', 'requirements', 'matchedSkills',
                               'missingSkills', 'suggestions'])
        && d.jdSnippet is string && d.jdSnippet.size() <= 300
        && d.createdAt == request.time
        && d.matchScore is int && d.matchScore >= 0 && d.matchScore <= 100
        && d.verdict in ['strong', 'good', 'partial', 'low']
        && d.jobTitle is string && d.jobTitle.size() <= 120
        && d.requirements is list && d.requirements.size() <= 40
        && d.matchedSkills is list && d.matchedSkills.size() <= 40
        && d.missingSkills is list && d.missingSkills.size() <= 40
        && d.suggestions is list && d.suggestions.size() <= 10;
    }

    function validScan(d) {
      return d.keys().hasOnly(['fileName', 'createdAt', 'atsScore', 'riskLevel',
                               'threatCount', 'threats', 'breakdown', 'suggestions'])
        && d.fileName is string && d.fileName.size() <= 200
        && d.createdAt == request.time
        && d.atsScore is int && d.atsScore >= 0 && d.atsScore <= 100
        && d.riskLevel in ['clean', 'low', 'medium', 'high']
        && d.threatCount is int && d.threatCount >= 0
        && d.threats is list && d.threats.size() <= 50
        && d.breakdown is list && d.breakdown.size() <= 10
        && d.suggestions is list && d.suggestions.size() <= 20;
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
