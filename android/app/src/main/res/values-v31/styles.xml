<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: plain dark green with no icon, so it
         blends straight into the Flutter splash animation. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/verixa_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/verixa_splash_bg</item>
    </style>
</resources>
